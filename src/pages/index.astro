---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import PropuestaValor from '../components/sections/PropuestaValor.astro';
import ActividadesClave from '../components/sections/ActividadesClave.astro';
import Ingresos from '../components/sections/Ingresos.astro';
import Segmentos from '../components/sections/Segmentos.astro';
import RelacionClientes from '../components/sections/RelacionClientes.astro';
import Canales from '../components/sections/Canales.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <!-- Bloques públicos del Modelo Canvas (los internos están en /gestion) -->
    <PropuestaValor />
    <ActividadesClave />
    <Ingresos />
    <Segmentos />
    <RelacionClientes />
    <Canales />
    <Contacto />
  </main>
  <Footer />
</Layout>
