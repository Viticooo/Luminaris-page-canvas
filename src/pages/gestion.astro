---
/**
 * Panel de gestión interna.
 * Menú a la izquierda, contenido a la derecha. Las vistas se cambian con el hash (#tareas, #proveedores…).
 * Los datos parten de src/data/interno.ts y los cambios se guardan en el navegador (localStorage).
 */
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import { LayoutDashboard, ListChecks, Truck, Boxes, Receipt, ArrowUpRight, Plus, Trash2, RotateCcw, X } from '@lucide/astro';
import { datosIniciales, areasTarea, categoriasRecurso, frecuencias, tiempoPorProyecto, notaCostos } from '../data/interno';

const menu = [
  { id: 'resumen', label: 'Resumen', icon: LayoutDashboard },
  { id: 'tareas', label: 'Tareas', icon: ListChecks },
  { id: 'proveedores', label: 'Proveedores', icon: Truck },
  { id: 'recursos', label: 'Recursos', icon: Boxes },
  { id: 'costos', label: 'Costos', icon: Receipt },
];

const stats = [
  { id: 'stat-pendientes', label: 'Tareas pendientes', href: '#tareas' },
  { id: 'stat-proveedores', label: 'Proveedores', href: '#proveedores' },
  { id: 'stat-recursos', label: 'Recursos', href: '#recursos' },
  { id: 'stat-gasto', label: 'Gasto mensual estimado', href: '#costos' },
];

// JSON seguro para incrustar en <script type="application/json">
const datosJson = JSON.stringify(datosIniciales).replace(/</g, '\\u003c');

const btnDel =
  'shrink-0 rounded-lg p-2 text-subtle transition hover:bg-white/[0.06] hover:text-orange sm:opacity-0 sm:group-hover:opacity-100 focus-visible:opacity-100';
---

<Layout title="Gestión — Luminaris" noindex>
  <div class="min-h-dvh lg:flex">
    <!-- ───────── Menú lateral (en móvil: barra superior con pestañas) ───────── -->
    <aside class="sticky top-0 z-40 border-b border-white/[0.07] bg-ink-2/90 backdrop-blur-xl lg:h-dvh lg:w-64 lg:shrink-0 lg:border-r lg:border-b-0">
      <div class="flex h-full flex-col">
        <div class="flex items-center justify-between px-5 py-4 lg:py-6">
          <a href="#resumen" class="flex items-center gap-2">
            <Logo class="h-7 w-7 text-indigo" title="" animated />
            <span class="font-semibold tracking-tight">Luminaris</span>
            <span class="rounded-md bg-white/[0.06] px-1.5 py-0.5 text-[11px] font-medium text-muted">Gestión</span>
          </a>
        </div>

        <nav aria-label="Gestión" class="overflow-x-auto px-3 pb-3 lg:flex-1 lg:pb-0">
          <ul id="side-nav" class="relative flex gap-1 lg:flex-col">
            <li aria-hidden="true" id="nav-pill" class="nav-pill pointer-events-none absolute left-0 top-0 rounded-xl bg-white/[0.08]"></li>
            {
              menu.map((m) => (
                <li class="relative">
                  <a
                    href={`#${m.id}`}
                    data-tab={m.id}
                    class="group flex items-center gap-3 whitespace-nowrap rounded-xl px-3 py-2 text-[14px] text-muted transition-colors hover:text-fg aria-[current=page]:text-fg"
                  >
                    <m.icon class="h-[18px] w-[18px] transition-colors group-aria-[current=page]:text-orange" stroke-width={1.75} />
                    {m.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="hidden space-y-1 border-t border-white/[0.07] p-3 lg:block">
          <button type="button" id="btn-reset" class="flex w-full items-center gap-3 rounded-xl px-3 py-2 text-[14px] text-muted hover:bg-white/[0.04] hover:text-fg">
            <RotateCcw class="h-[18px] w-[18px]" stroke-width={1.75} />
            Restablecer datos
          </button>
          <a href="/" class="flex items-center gap-3 rounded-xl px-3 py-2 text-[14px] text-muted hover:bg-white/[0.04] hover:text-fg">
            <ArrowUpRight class="h-[18px] w-[18px]" stroke-width={1.75} />
            Ver sitio público
          </a>
        </div>
      </div>
    </aside>

    <!-- ───────── Contenido ───────── -->
    <main class="flex-1 px-5 py-8 sm:px-10 lg:py-12">
      <div class="mx-auto max-w-5xl">
        <!-- Resumen -->
        <section data-panel="resumen">
          <h1 class="text-3xl font-semibold tracking-tight">Resumen</h1>
          <p class="mt-1 text-muted">Información interna de Luminaris.</p>

          <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {
              stats.map((s, i) => (
                <a href={s.href} class="card item-in block p-6 transition hover:-translate-y-0.5 hover:bg-card-2" style={`--d:${i * 60}ms`}>
                  <p id={s.id} class="text-3xl font-semibold tracking-tight tabular-nums sm:text-4xl">–</p>
                  <p class="mt-2 text-sm text-muted">{s.label}</p>
                </a>
              ))
            }
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-3">
            <div class="card p-6 lg:col-span-2">
              <div class="flex items-center justify-between">
                <h2 class="font-semibold">Próximas tareas</h2>
                <a href="#tareas" class="text-sm text-indigo-soft hover:text-fg">Ver todas</a>
              </div>
              <ul id="list-proximas" class="mt-4 divide-y divide-white/[0.07]"></ul>
              <p id="empty-proximas" class="mt-4 text-sm text-subtle" hidden>No hay tareas pendientes.</p>
            </div>
            <div class="rounded-3xl bg-indigo p-6 text-white">
              <h2 class="font-semibold">Tiempo por proyecto</h2>
              <p class="mt-6 text-5xl font-semibold tracking-tight">{tiempoPorProyecto}</p>
              <p class="mt-2 text-sm text-white/75">Duración aproximada de cada proyecto.</p>
            </div>
          </div>
        </section>

        <!-- Tareas -->
        <section data-panel="tareas" hidden>
          <header class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h1 class="text-3xl font-semibold tracking-tight">Tareas</h1>
              <p class="mt-1 text-muted"><span id="count-tareas">0</span> tareas en total.</p>
            </div>
            <button type="button" data-open="tareas" class="btn btn-primary !py-2 text-sm"><Plus class="h-4 w-4" /> Nueva tarea</button>
          </header>

          <div class="mt-8 flex gap-2" role="group" aria-label="Filtrar tareas">
            {
              [
                ['todas', 'Todas'],
                ['pendiente', 'Pendientes'],
                ['hecha', 'Hechas'],
              ].map(([v, l], i) => (
                <button
                  type="button"
                  data-filter={v}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  class="rounded-full border border-white/10 px-4 py-1.5 text-sm text-muted transition hover:text-fg aria-pressed:border-transparent aria-pressed:bg-fg aria-pressed:text-ink"
                >
                  {l}
                </button>
              ))
            }
          </div>

          <ul id="list-tareas" data-entity="tareas" class="card mt-4 divide-y divide-white/[0.07] overflow-hidden"></ul>
        </section>

        <!-- Proveedores -->
        <section data-panel="proveedores" hidden>
          <header class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h1 class="text-3xl font-semibold tracking-tight">Proveedores</h1>
              <p class="mt-1 text-muted">Socios clave del Modelo Canvas.</p>
            </div>
            <button type="button" data-open="proveedores" class="btn btn-primary !py-2 text-sm"><Plus class="h-4 w-4" /> Nuevo proveedor</button>
          </header>

          <div class="card mt-8 overflow-x-auto">
            <table class="w-full min-w-[560px] text-left text-[15px]">
              <thead class="text-xs uppercase tracking-wider text-subtle">
                <tr class="border-b border-white/[0.07]">
                  <th class="px-5 py-3 font-medium">Proveedor</th>
                  <th class="px-5 py-3 font-medium">Servicio</th>
                  <th class="px-5 py-3 font-medium">Contacto</th>
                  <th class="w-12 px-3 py-3"><span class="sr-only">Acciones</span></th>
                </tr>
              </thead>
              <tbody id="list-proveedores" data-entity="proveedores" class="divide-y divide-white/[0.07]"></tbody>
            </table>
          </div>
        </section>

        <!-- Recursos -->
        <section data-panel="recursos" hidden>
          <header class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h1 class="text-3xl font-semibold tracking-tight">Recursos</h1>
              <p class="mt-1 text-muted">Recursos clave del Modelo Canvas.</p>
            </div>
            <button type="button" data-open="recursos" class="btn btn-primary !py-2 text-sm"><Plus class="h-4 w-4" /> Nuevo recurso</button>
          </header>

          <ul id="list-recursos" data-entity="recursos" class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3"></ul>
        </section>

        <!-- Costos -->
        <section data-panel="costos" hidden>
          <header class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h1 class="text-3xl font-semibold tracking-tight">Costos</h1>
              <p class="mt-1 text-muted">Estructura de costos del Modelo Canvas. Montos en MXN.</p>
            </div>
            <button type="button" data-open="costos" class="btn btn-primary !py-2 text-sm"><Plus class="h-4 w-4" /> Nuevo costo</button>
          </header>

          <div class="mt-8 grid gap-4 lg:grid-cols-3">
            <div class="card overflow-x-auto lg:col-span-2">
              <table class="w-full min-w-[480px] text-left text-[15px]">
                <thead class="text-xs uppercase tracking-wider text-subtle">
                  <tr class="border-b border-white/[0.07]">
                    <th class="px-5 py-3 font-medium">Concepto</th>
                    <th class="px-5 py-3 font-medium">Frecuencia</th>
                    <th class="px-5 py-3 text-right font-medium">Monto</th>
                    <th class="w-12 px-3 py-3"><span class="sr-only">Acciones</span></th>
                  </tr>
                </thead>
                <tbody id="list-costos" data-entity="costos" class="divide-y divide-white/[0.07]"></tbody>
              </table>
            </div>
            <div class="space-y-4">
              <div class="rounded-3xl bg-indigo p-6 text-white">
                <h2 class="font-semibold">Gasto mensual estimado</h2>
                <p id="total-mensual" class="mt-4 text-4xl font-semibold tracking-tight tabular-nums">–</p>
                <p class="mt-2 text-sm text-white/75">Incluye los pagos anuales prorrateados.</p>
              </div>
              <div class="card p-6">
                <h2 class="font-semibold">Tiempo por proyecto</h2>
                <p class="mt-3 text-3xl font-semibold tracking-tight">{tiempoPorProyecto}</p>
                <p class="mt-4 border-t border-white/[0.07] pt-4 text-sm leading-relaxed text-muted">{notaCostos}</p>
              </div>
            </div>
          </div>
        </section>

        <button type="button" id="btn-reset-mobile" class="mt-12 flex items-center gap-2 text-sm text-subtle hover:text-fg lg:hidden">
          <RotateCcw class="h-4 w-4" /> Restablecer datos de ejemplo
        </button>
      </div>
    </main>
  </div>

  <!-- ───────── Formularios (diálogos) ───────── -->
  {
    [
      { entity: 'tareas', title: 'Nueva tarea' },
      { entity: 'proveedores', title: 'Nuevo proveedor' },
      { entity: 'recursos', title: 'Nuevo recurso' },
      { entity: 'costos', title: 'Nuevo costo' },
    ].map((d) => (
      <dialog
        id={`dlg-${d.entity}`}
        class="m-auto w-[min(92vw,440px)] rounded-3xl border border-white/10 bg-card p-0 text-fg backdrop:bg-black/70 backdrop:backdrop-blur-sm"
      >
        <form data-entity={d.entity} class="space-y-4 p-6 sm:p-7">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold tracking-tight">{d.title}</h2>
            <button type="button" data-close class="rounded-lg p-1.5 text-subtle hover:bg-white/[0.06] hover:text-fg" aria-label="Cerrar">
              <X class="h-5 w-5" />
            </button>
          </div>

          {d.entity === 'tareas' && (
            <>
              <label class="block space-y-1.5"><span class="text-sm text-muted">Tarea</span><input name="titulo" required maxlength="120" class="field" placeholder="Ej. Llamar al cliente" /></label>
              <label class="block space-y-1.5"><span class="text-sm text-muted">Área</span>
                <select name="area" class="field">{areasTarea.map((a) => <option>{a}</option>)}</select>
              </label>
            </>
          )}
          {d.entity === 'proveedores' && (
            <>
              <label class="block space-y-1.5"><span class="text-sm text-muted">Nombre</span><input name="nombre" required maxlength="80" class="field" placeholder="Ej. Papelería Centro" /></label>
              <label class="block space-y-1.5"><span class="text-sm text-muted">Servicio</span><input name="servicio" required maxlength="120" class="field" placeholder="Ej. Impresión de tarjetas" /></label>
              <label class="block space-y-1.5"><span class="text-sm text-muted">Contacto</span><input name="contacto" maxlength="120" class="field" placeholder="Teléfono, correo o sitio web" /></label>
            </>
          )}
          {d.entity === 'recursos' && (
            <>
              <label class="block space-y-1.5"><span class="text-sm text-muted">Recurso</span><input name="nombre" required maxlength="80" class="field" placeholder="Ej. Impresora" /></label>
              <label class="block space-y-1.5"><span class="text-sm text-muted">Categoría</span>
                <select name="categoria" class="field">{categoriasRecurso.map((c) => <option>{c}</option>)}</select>
              </label>
            </>
          )}
          {d.entity === 'costos' && (
            <>
              <label class="block space-y-1.5"><span class="text-sm text-muted">Concepto</span><input name="concepto" required maxlength="120" class="field" placeholder="Ej. Licencia de diseño" /></label>
              <div class="grid grid-cols-2 gap-3">
                <label class="block space-y-1.5"><span class="text-sm text-muted">Frecuencia</span>
                  <select name="frecuencia" class="field">{frecuencias.map((f) => <option value={f.value}>{f.label}</option>)}</select>
                </label>
                <label class="block space-y-1.5"><span class="text-sm text-muted">Monto (MXN)</span><input name="monto" type="number" min="0" step="1" required class="field" placeholder="0" /></label>
              </div>
            </>
          )}

          <div class="flex justify-end gap-2 pt-2">
            <button type="button" data-close class="btn btn-outline !py-2 text-sm">Cancelar</button>
            <button type="submit" class="btn btn-primary !py-2 text-sm">Guardar</button>
          </div>
        </form>
      </dialog>
    ))
  }

  <!-- ───────── Plantillas de filas (se llenan con textContent: sin inyección de HTML) ───────── -->
  <template id="tpl-tareas">
    <li class="group flex items-center gap-4 px-5 py-3.5">
      <input type="checkbox" data-f="hecha" class="peer h-5 w-5 shrink-0 cursor-pointer accent-indigo" />
      <span data-f="titulo" class="flex-1 transition-colors peer-checked:text-subtle peer-checked:line-through"></span>
      <span data-f="area" class="hidden rounded-full bg-white/[0.06] px-2.5 py-1 text-xs text-muted sm:inline"></span>
      <button type="button" data-del class={btnDel} aria-label="Eliminar"><Trash2 class="h-4 w-4" /></button>
    </li>
  </template>
  <template id="tpl-proveedores">
    <tr class="group">
      <td data-f="nombre" class="px-5 py-4 font-medium"></td>
      <td data-f="servicio" class="px-5 py-4 text-muted"></td>
      <td data-f="contacto" class="px-5 py-4 text-muted"></td>
      <td class="px-3 py-2 text-right"><button type="button" data-del class={btnDel} aria-label="Eliminar"><Trash2 class="h-4 w-4" /></button></td>
    </tr>
  </template>
  <template id="tpl-recursos">
    <li class="card group relative p-6 transition hover:bg-card-2">
      <p data-f="categoria" class="text-xs font-semibold uppercase tracking-wider text-orange"></p>
      <p data-f="nombre" class="mt-4 font-medium"></p>
      <button type="button" data-del class={`${btnDel} absolute right-3 top-3`} aria-label="Eliminar"><Trash2 class="h-4 w-4" /></button>
    </li>
  </template>
  <template id="tpl-costos">
    <tr class="group">
      <td data-f="concepto" class="px-5 py-4"></td>
      <td data-f="frecuencia" class="px-5 py-4 text-muted"></td>
      <td data-f="monto" class="px-5 py-4 text-right tabular-nums"></td>
      <td class="px-3 py-2 text-right"><button type="button" data-del class={btnDel} aria-label="Eliminar"><Trash2 class="h-4 w-4" /></button></td>
    </tr>
  </template>
  <template id="tpl-proximas">
    <li class="flex items-center justify-between gap-4 py-3">
      <span data-f="titulo"></span>
      <span data-f="area" class="shrink-0 text-xs text-subtle"></span>
    </li>
  </template>

  <script type="application/json" id="datos-iniciales" set:html={datosJson} />

  <script>
    type Entity = 'tareas' | 'proveedores' | 'recursos' | 'costos';
    type Item = Record<string, any> & { id: string };
    type Datos = Record<Entity, Item[]>;

    const KEY = 'luminaris:gestion:v1';
    const defaults: Datos = JSON.parse(document.getElementById('datos-iniciales')!.textContent!);
    const copy = (d: Datos): Datos => JSON.parse(JSON.stringify(d));

    function load(): Datos {
      try {
        const raw = localStorage.getItem(KEY);
        if (raw) return { ...copy(defaults), ...JSON.parse(raw) };
      } catch {}
      return copy(defaults);
    }
    function save() {
      try {
        localStorage.setItem(KEY, JSON.stringify(data));
      } catch {}
    }

    let data = load();
    let filtro: 'todas' | 'pendiente' | 'hecha' = 'todas';
    let recienAgregado: string | null = null;

    const mxn = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 });
    const freqLabel: Record<string, string> = { mensual: 'Mensual', anual: 'Anual', unico: 'Pago único' };
    const gastoMensual = () =>
      data.costos.reduce((s, c) => s + (c.frecuencia === 'mensual' ? c.monto : c.frecuencia === 'anual' ? c.monto / 12 : 0), 0);
    const newId = () => (crypto.randomUUID ? crypto.randomUUID() : String(Date.now() + Math.random()));

    // ───────── Render ─────────
    function row(entity: string, item: Item) {
      const tpl = document.getElementById(`tpl-${entity}`) as HTMLTemplateElement;
      const el = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      el.dataset.id = item.id;
      el.querySelectorAll<HTMLElement>('[data-f]').forEach((f) => {
        const k = f.dataset.f!;
        if (f instanceof HTMLInputElement) f.checked = !!item[k];
        else if (k === 'monto') f.textContent = mxn.format(item[k]);
        else if (k === 'frecuencia') f.textContent = freqLabel[item[k]] ?? item[k];
        else f.textContent = item[k] || '—';
      });
      if (item.id === recienAgregado) el.classList.add('item-in');
      return el;
    }

    function render() {
      (['tareas', 'proveedores', 'recursos', 'costos'] as Entity[]).forEach((e) => {
        const list = document.getElementById(`list-${e}`)!;
        list.replaceChildren(...data[e].map((it) => row(e, it)));
      });
      aplicarFiltro();

      const pendientes = data.tareas.filter((t) => !t.hecha);
      document.getElementById('list-proximas')!.replaceChildren(...pendientes.slice(0, 4).map((t) => row('proximas', { ...t, id: '' })));
      document.getElementById('empty-proximas')!.hidden = pendientes.length > 0;

      document.getElementById('stat-pendientes')!.textContent = String(pendientes.length);
      document.getElementById('stat-proveedores')!.textContent = String(data.proveedores.length);
      document.getElementById('stat-recursos')!.textContent = String(data.recursos.length);
      document.getElementById('stat-gasto')!.textContent = mxn.format(gastoMensual());
      document.getElementById('total-mensual')!.textContent = mxn.format(gastoMensual());
      document.getElementById('count-tareas')!.textContent = String(data.tareas.length);
      recienAgregado = null;
    }

    function aplicarFiltro() {
      document.querySelectorAll<HTMLElement>('#list-tareas > li').forEach((li) => {
        const hecha = li.querySelector('input')!.checked;
        li.hidden = filtro !== 'todas' && (filtro === 'hecha') !== hecha;
      });
    }

    // ───────── Navegación entre secciones ─────────
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
    const pill = document.getElementById('nav-pill')!;
    const sideNav = document.getElementById('side-nav')!;

    function moverPill() {
      const active = tabs.find((t) => t.getAttribute('aria-current') === 'page');
      if (!active) return;
      const a = active.getBoundingClientRect();
      const n = sideNav.getBoundingClientRect();
      pill.style.width = `${a.width}px`;
      pill.style.height = `${a.height}px`;
      pill.style.transform = `translate(${a.left - n.left}px, ${a.top - n.top}px)`;
    }

    function show() {
      const id = location.hash.slice(1);
      const current = panels.some((p) => p.dataset.panel === id) ? id : 'resumen';
      panels.forEach((p) => {
        const visible = p.dataset.panel === current;
        if (visible && p.hidden) {
          p.classList.remove('panel-enter');
          void p.offsetWidth; // reinicia la animación
          p.classList.add('panel-enter');
        }
        p.hidden = !visible;
      });
      tabs.forEach((t) => (t.dataset.tab === current ? t.setAttribute('aria-current', 'page') : t.removeAttribute('aria-current')));
      moverPill();
      window.scrollTo({ top: 0 });
    }
    window.addEventListener('hashchange', show);
    window.addEventListener('resize', moverPill);

    // ───────── Acciones ─────────
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    filters.forEach((btn) =>
      btn.addEventListener('click', () => {
        filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        filtro = btn.dataset.filter as typeof filtro;
        aplicarFiltro();
      }),
    );

    document.addEventListener('change', (ev) => {
      const input = ev.target as HTMLElement;
      if (!(input instanceof HTMLInputElement) || input.dataset.f !== 'hecha') return;
      const id = input.closest<HTMLElement>('[data-id]')!.dataset.id;
      const t = data.tareas.find((x) => x.id === id);
      if (t) t.hecha = input.checked;
      save();
      render();
    });

    document.addEventListener('click', (ev) => {
      const target = ev.target as HTMLElement;

      const del = target.closest<HTMLElement>('[data-del]');
      if (del) {
        const el = del.closest<HTMLElement>('[data-id]')!;
        const entity = el.closest<HTMLElement>('[data-entity]')!.dataset.entity as Entity;
        const borrar = () => {
          data[entity] = data[entity].filter((x) => x.id !== el.dataset.id);
          save();
          render();
        };
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return borrar();
        el.classList.add('item-out');
        el.addEventListener('animationend', borrar, { once: true });
        return;
      }

      const open = target.closest<HTMLElement>('[data-open]');
      if (open) {
        const dlg = document.getElementById(`dlg-${open.dataset.open}`) as HTMLDialogElement;
        dlg.showModal();
        return;
      }

      if (target.closest('[data-close]')) {
        target.closest('dialog')?.close();
        return;
      }
      // Clic fuera del diálogo (en el fondo) lo cierra.
      if (target instanceof HTMLDialogElement) target.close();
    });

    document.querySelectorAll<HTMLFormElement>('dialog form').forEach((form) =>
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const entity = form.dataset.entity as Entity;
        const fd = Object.fromEntries(new FormData(form)) as Record<string, string>;
        const item: Item = { id: newId(), ...fd };
        if (entity === 'tareas') item.hecha = false;
        if (entity === 'costos') item.monto = Number(fd.monto) || 0;
        data[entity].unshift(item);
        recienAgregado = item.id;
        save();
        render();
        form.reset();
        form.closest('dialog')!.close();
      }),
    );

    const reset = () => {
      if (!confirm('¿Restablecer los datos de ejemplo? Se perderán los cambios guardados en este navegador.')) return;
      try {
        localStorage.removeItem(KEY);
      } catch {}
      data = copy(defaults);
      render();
    };
    document.getElementById('btn-reset')!.addEventListener('click', reset);
    document.getElementById('btn-reset-mobile')!.addEventListener('click', reset);

    render();
    show();
    // Recolocar la píldora cuando cargue la fuente (cambia el ancho de los textos).
    document.fonts?.ready.then(moverPill);
  </script>
</Layout>
