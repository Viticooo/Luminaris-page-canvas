---
import SectionHeader from '../SectionHeader.astro';

const channels = [
  {
    title: 'Recomendación de clientes',
    text: 'Clientes que ya trabajaron con nosotros y nos recomiendan con otros negocios.',
    tags: [],
  },
  {
    title: 'Plataformas profesionales',
    text: 'Compartimos nuestro trabajo en plataformas como LinkedIn.',
    tags: ['LinkedIn'],
  },
  {
    title: 'Redes sociales',
    text: 'Estamos presentes en las redes que usas todos los días.',
    tags: ['Instagram', 'Facebook', 'WhatsApp'],
  },
];
---

<section id="canales" class="section bg-ink-2">
  <div class="container-x">
    <SectionHeader canvas="Canales" title="Dónde encontrarnos." lead="Los caminos por los que llegamos a nuestros clientes." />

    <div class="mt-16 grid gap-5 md:grid-cols-3">
      {
        channels.map((c, i) => (
          <article data-reveal style={`--delay:${i * 100}ms`} class="card lift flex flex-col p-8">
            <h3 class="text-xl font-semibold tracking-tight">{c.title}</h3>
            <p class="mt-2 flex-1 text-muted">{c.text}</p>
            {c.tags.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {c.tags.map((t) => (
                  <li class="rounded-full border border-white/10 px-3 py-1 text-xs text-muted">{t}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
