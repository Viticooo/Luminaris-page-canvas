---
import SectionHeader from '../SectionHeader.astro';

const items = [
  {
    title: 'Calidad de servicio',
    text: 'Cuidamos cada detalle de tu proyecto, de la primera conversación a la entrega.',
  },
  {
    title: 'Facilidad de pagos',
    text: 'Hacemos que pagar por tu proyecto sea un proceso sencillo y sin complicaciones.',
  },
  {
    title: 'Precios competitivos',
    text: 'Tecnología profesional a un precio accesible para pequeñas y medianas empresas.',
  },
];
---

<section id="propuesta" class="section">
  <div class="container-x">
    <SectionHeader
      canvas="Propuesta de valor"
      title="Lo que nos hace diferentes."
      lead="Tres compromisos que guían cada proyecto que hacemos."
      align="center"
    />

    <div class="mt-16 grid gap-5 md:grid-cols-3">
      {
        items.map((it, i) => (
          <article data-reveal style={`--delay:${i * 100}ms`} class="card lift p-8 sm:p-10">
            <p class="text-sm font-semibold text-orange">0{i + 1}</p>
            <h3 class="mt-6 text-2xl font-semibold tracking-tight">{it.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{it.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
