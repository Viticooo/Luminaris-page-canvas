---
import SectionHeader from '../SectionHeader.astro';

const services = [
  { title: 'Creación de páginas web', text: 'Tu sitio, desde cero y listo para publicarse.' },
  { title: 'Mantenimiento de páginas web', text: 'Mantenemos tu sitio funcionando correctamente.' },
  { title: 'Actualizaciones de páginas web', text: 'Nuevos contenidos y mejoras cuando tu negocio lo necesite.' },
];
---

<section id="servicios" class="section">
  <div class="container-x">
    <SectionHeader
      canvas="Ingresos"
      title="Lo que puedes contratar."
      lead="Servicios web de principio a fin y un producto físico para tu negocio."
    />

    <div class="mt-16 grid gap-5 lg:grid-cols-5">
      <div class="grid gap-5 sm:grid-cols-3 lg:col-span-3 lg:grid-cols-1">
        {
          services.map((s, i) => (
            <article data-reveal style={`--delay:${i * 80}ms`} class="card lift p-7">
              <h3 class="text-lg font-semibold tracking-tight">{s.title}</h3>
              <p class="mt-1.5 text-muted">{s.text}</p>
            </article>
          ))
        }
      </div>

      <article data-reveal style="--delay:200ms" class="flex flex-col justify-end rounded-3xl bg-indigo p-8 text-white sm:p-10 lg:col-span-2">
        <span class="w-fit rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider">Producto</span>
        <h3 class="mt-16 text-3xl font-semibold tracking-tight">Placas para calificar negocios</h3>
        <p class="mt-3 text-lg leading-relaxed text-white/80">
          Placas con QR y NFC para que tus clientes dejen su calificación en segundos.
        </p>
      </article>
    </div>
  </div>
</section>
