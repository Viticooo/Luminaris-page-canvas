---
import SectionHeader from '../SectionHeader.astro';

const stats = [
  { from: 20, to: 40, unit: 'años', label: 'Público al que nos dirigimos.' },
  { from: 10, to: 20, unit: 'personas', label: 'Empresas chicas.' },
  { from: 30, to: 70, unit: 'personas', label: 'Empresas medianas.' },
];
---

<section id="para-quien" class="section bg-ink-2">
  <div class="container-x">
    <SectionHeader
      canvas="Segmentos de clientes"
      title="Hecho para pymes."
      lead="Nos enfocamos en pequeñas y medianas empresas, con un público de entre 20 y 40 años."
      align="center"
    />

    <div class="mt-16 grid gap-px overflow-hidden rounded-3xl border border-white/[0.07] bg-white/[0.07] sm:grid-cols-3">
      {
        stats.map((s, i) => (
          <div data-reveal style={`--delay:${i * 100}ms`} class="bg-card p-10 text-center">
            <p class="text-5xl font-semibold tracking-tight tabular-nums sm:text-6xl">
              <span data-countup={s.from}>{s.from}</span>–<span data-countup={s.to}>{s.to}</span>
            </p>
            <p class="mt-2 text-sm font-medium uppercase tracking-wider text-orange">{s.unit}</p>
            <p class="mt-4 text-muted">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
