---
import { Mail, MessageCircle } from '@lucide/astro';
import Logo from './Logo.astro';
import { site } from '../data/site';

const whatsappUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<section id="contacto" class="section bg-ink-2">
  <div class="container-x">
    <div data-reveal="scale" class="rounded-[2.5rem] bg-indigo px-6 py-20 text-center text-white sm:px-16 sm:py-28">
      <Logo class="mx-auto h-12 w-12 text-white" title="" animated />
      <h2 class="mx-auto mt-8 max-w-2xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        ¿Listo para darle luz a tu proyecto?
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/80">Cuéntanos qué necesitas y te respondemos.</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={`mailto:${site.email}`} class="btn bg-white text-ink hover:bg-white/90">
          <Mail class="h-4 w-4" /> Escríbenos un correo
        </a>
        <a href={whatsappUrl} target="_blank" rel="noopener" class="btn border border-white/40 text-white hover:bg-white/10">
          <MessageCircle class="h-4 w-4" /> Escríbenos por WhatsApp
        </a>
      </div>
      <p class="mt-6 text-sm text-white/60">{site.email}</p>
    </div>
  </div>
</section>
