---
/** Ilustración genérica animada: placa de calificación con QR y NFC. */

// Patrón decorativo tipo QR (determinista, no es un código real).
const N = 21;
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const inFinder = (x: number, y: number) =>
  (x < 8 && y < 8) || (x > N - 9 && y < 8) || (x < 8 && y > N - 9);
const cells: { x: number; y: number }[] = [];
for (let y = 0; y < N; y++)
  for (let x = 0; x < N; x++) if (!inFinder(x, y) && rand() > 0.52) cells.push({ x, y });
const finders = [
  [0, 0],
  [N - 7, 0],
  [0, N - 7],
];
---

<div class="card flex aspect-[4/3] items-center justify-center p-6" role="img" aria-label="Ilustración de una placa de calificación con código QR y NFC">
  <div class="relative w-[62%] max-w-[260px] rounded-[1.75rem] bg-[#f5f5f7] p-5 text-ink shadow-[0_30px_60px_-20px_rgba(0,0,0,0.8)] sm:p-6">
    <!-- Ondas NFC -->
    <svg class="absolute -right-9 top-6 h-12 w-8 text-indigo-soft" viewBox="0 0 32 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <path class="nfc-wave" style="--d:0s" d="M4 16a12 12 0 0 1 0 16" />
      <path class="nfc-wave" style="--d:0.4s" d="M12 10a20 20 0 0 1 0 28" />
      <path class="nfc-wave" style="--d:0.8s" d="M20 4a28 28 0 0 1 0 40" />
    </svg>

    <p class="text-center text-[13px] font-semibold leading-tight sm:text-[15px]">¿Cómo fue tu visita?</p>

    <div class="relative mx-auto mt-4 aspect-square w-full overflow-hidden rounded-lg">
      <svg viewBox={`-1 -1 ${N + 2} ${N + 2}`} class="h-full w-full" shape-rendering="crispEdges" aria-hidden="true">
        {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" fill="#0a0a0b" />)}
        {
          finders.map(([x, y]) => (
            <g>
              <rect x={x + 0.5} y={y + 0.5} width="6" height="6" fill="none" stroke="#0a0a0b" stroke-width="1" />
              <rect x={x + 2} y={y + 2} width="3" height="3" fill="#0a0a0b" />
            </g>
          ))
        }
      </svg>
      <span class="scan-line absolute inset-x-0 h-0.5 bg-orange shadow-[0_0_10px_2px_rgba(255,122,26,0.55)]" aria-hidden="true"></span>
    </div>

    <div class="mt-4 flex justify-center gap-1" aria-hidden="true">
      {
        [0, 1, 2, 3, 4].map((i) => (
          <svg class="star-fill h-4 w-4 text-black/15" style={`--d:${i * 0.15}s`} viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01z" />
          </svg>
        ))
      }
    </div>
    <p class="mt-2 text-center text-[11px] text-black/50">Escanea o acerca tu celular</p>
  </div>
</div>
