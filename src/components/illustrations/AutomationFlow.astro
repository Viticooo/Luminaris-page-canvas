---
/** Ilustración genérica animada: un flujo automatizado paso a paso. */
const steps = [
  { label: 'Llega un nuevo pedido', meta: 'Formulario web' },
  { label: 'El script procesa los datos', meta: 'Automatización' },
  { label: 'Se actualiza el inventario', meta: 'Hoja de cálculo' },
  { label: 'Se envía la confirmación', meta: 'Correo al cliente' },
];
---

<div class="card flex aspect-[4/3] flex-col justify-center p-6 sm:p-10" role="img" aria-label="Ilustración de un proceso automatizado en cuatro pasos">
  <div class="relative">
    <!-- Línea con punto que recorre el flujo -->
    <div class="absolute bottom-6 left-[19px] top-6 w-px bg-white/10" aria-hidden="true">
      <span class="flow-dot absolute -left-[3px] h-[7px] w-[7px] rounded-full bg-orange shadow-[0_0_12px_2px_rgba(255,122,26,0.6)]"></span>
    </div>

    <ol class="relative space-y-3">
      {
        steps.map((s, i) => (
          <li class="flow-step flex items-center gap-4 rounded-2xl border border-white/[0.07] px-3 py-3" style={`--d:${i * 1.4}s`}>
            <span class="flex h-[15px] w-[15px] shrink-0 items-center justify-center rounded-full border border-white/20 bg-ink ml-[12px]">
              <span class="h-1.5 w-1.5 rounded-full bg-indigo-soft" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-[15px] font-medium">{s.label}</span>
              <span class="block text-xs text-subtle">{s.meta}</span>
            </span>
            <svg class="flow-check h-5 w-5 shrink-0 text-indigo-soft" style={`--d:${i * 1.4}s`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </li>
        ))
      }
    </ol>
  </div>
</div>
